# Ticket Triage Agent - Environment Variables
# Copy this to .env and fill in your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# LLM Configuration
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_FACTOR=2.0
PROVIDER_PREFERENCE=google_genai,groq,huggingface,openai,fallback

# API Keys (optional - leave blank if not using)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Knowledge Base
KB_PATH=kb/sample_kb.json
KB_SEARCH_TOP_K=3

# Prompts
PROMPTS_DIR=prompts
TRIAGE_PROMPT_FILE=prompts/triage_prompt.txt

# Security
ADMIN_TOKEN=your-secure-token-here
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Validation
DESCRIPTION_MIN_LENGTH=1
DESCRIPTION_MAX_LENGTH=10000
